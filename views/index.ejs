
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Caméra - Capture Photo</title>
  <link rel="stylesheet" href="/style.css?v=20261105-rotation">
  

</head>

<body class="photo-page" data-username="<%= userName %>">
  <header class="site-header">
    <div class="site-brand">
      <img class="quebec-flag" src="/images/drapeau-quebec.svg" alt="Drapeau du Québec" width="66" height="44">
      <span class="agency-name">Régie des alcools,<br>des courses et des jeux</span>
    </div>
    <div class="header-session">
      <div class="session-name"><span>Utilisateur connecté</span><strong><%= userName %></strong></div>
      <form action="/logout" method="post"><button class="logout-button" type="submit">Déconnexion</button></form>
    </div>
  </header>
  <main class="app-content">
  <h1>📷 Capture de Photo</h1>
  <div class="camera-container">
    <div class="video-section">
      <video id="video" autoplay></video>
      <canvas id="canvas"></canvas>
      <img id="photo" style="display: none;" alt="Aperçu de la photo à enregistrer" />
      <div id="photoRotationControls" class="photo-rotation-controls" hidden>
        <button type="button" id="rotateLeft" disabled aria-controls="photo">↶ Tourner à gauche</button>
        <button type="button" id="rotateRight" disabled aria-controls="photo">↷ Tourner à droite</button>
      </div>
      <p id="photoStatus" class="photo-status" role="status" aria-live="polite" hidden></p>
      
      <!-- Date + Photo alignés en bas -->
      <div class="photo-info" id="photo-info" style="display: none;">
      <br>
      <h4>Aperçu de la photo existante</h4>
        <img id="infoPhoto" src="" alt="Photo client" style="max-width: 300px; margin-top: 10px;">
        <button type="button" id="editExistingPhoto" class="edit-existing-photo" disabled>Corriger cette photo</button>
        <p><strong>Date Prise photo :</strong> <span id="infoDate"></span></p>
      </div>
    </div>
  
    <div class="controls">
      <label for="clientId">🆔 ID du dossier client :</label>
      <div class="input-row">
        <input type="number" id="clientId" required placeholder="Entrez l'ID du client">
        <button id="btnRecherche" disabled>🔍 Rechercher</button>
      </div>
  
      <div>
        <label for="clientNom">👤 Nom :</label>
        <input type="text" id="clientNom" readonly>
  
        <label for="clientPrenom">👤 Prénom :</label>
        <input type="text" id="clientPrenom" readonly>
      </div>
  
      <label for="importPhoto">📂 Importer une photo :</label>
      <input type="file" id="importPhoto" accept="image/*" disabled>
  
      <div class="range-group">
        <label for="outputWidth">📏 Largeur :</label>
        <input type="range" id="outputWidth" min="100" max="500" step="10" value="200">
        <span id="widthValue">200</span>
      </div>
  
      <div class="range-group">
        <label for="outputHeight">📐 Hauteur :</label>
        <input type="range" id="outputHeight" min="100" max="500" step="10" value="200">
        <span id="heightValue">200</span>
      </div>
  
      <div class="range-group">
        <label>Luminosité :</label>
        <input type="range" id="brightness" min="50" max="200" step="10" value="100">
      </div>
  
      <div class="range-group">
        <label>Contraste :</label>
        <input type="range" id="contrast" min="-100" max="100" step="1" value="0">
      </div>
  
      <div class="range-group">
        <label>Exposition :</label>
        <input type="range" id="exposure" min="-100" max="100" step="1" value="0">
      </div>
  
      <div class="range-group">
        <label>Zoom :</label>
        <input type="range" id="zoom" min="1" max="3" step="0.1" value="1">
      </div>
  
      <button id="capture" disabled>📸 Prendre la photo</button>
      <button id="restart" style="display:none;">🔄 Reprendre la photo</button>
      <button id="send" disabled>📤 Envoyer vers Oracle</button>  </div>
  </div>
  
  </main>
  <script src="/script.js?v=20261105-rotation"></script>
</body>
</html>
