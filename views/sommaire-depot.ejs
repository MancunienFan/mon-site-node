<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sommaire de dépôt</title><link rel="stylesheet" href="/style.css"></head>
<body><header class="site-header"><div class="site-brand"><img class="quebec-flag" src="/images/drapeau-quebec.svg" alt="Drapeau du Québec"><span class="agency-name">Régie des alcools,<br>des courses et des jeux</span></div><div class="header-session"><div class="session-name"><span>Utilisateur connecté</span><strong><%= userName %></strong></div><form action="/logout" method="post"><button class="logout-button">Déconnexion</button></form></div></header>
<main class="app-content"><nav class="app-nav"><a href="/index">Capture photo</a><a href="/sommaire-depot" aria-current="page">Sommaire de dépôt</a></nav><h1>Sommaire de dépôt</h1><section class="depot-panel"><form id="depot-form" class="depot-form"><label>Date du dépôt <input type="date" name="date_recu" required></label><label>Lieu <select name="endroit" required><option value="">Chargement…</option></select></label><label>Numéro de bordereau <input name="bordereau" type="text"></label><button>Rechercher</button><button id="depot-pdf" type="button" disabled>Télécharger le PDF</button></form><p id="depot-status" role="status" aria-live="polite"></p><div class="depot-scroll"><table><thead><tr><th>Reçu</th><th>Type paiement</th><th>Dossier</th><th>Événement</th><th>Mode paiement</th><th>Montant</th></tr></thead><tbody id="depot-result"></tbody></table></div></section></main><script src="/sommaire-depot.js"></script></body></html>
